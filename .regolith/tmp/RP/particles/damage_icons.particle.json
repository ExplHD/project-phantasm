{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:damage_icons",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/damage_indicator/icons"
			}
		},
		"curves": {
			"variable.size": {
				"type": "linear",
				"input": "v.emitter_age",
				"horizontal_range": "v.length",
				"nodes": [0, 1, 1, 1, 1, 0.75, 0]
			}
		},
		"events": {
			"spawn": {
				"expression": "v.number  = v.number + 1;"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.number = 1;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "v.digits"
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": "v.length + 1"
			},
			"minecraft:emitter_shape_point": {
				"offset": [ 0, 0, 0 ],
				"direction": [0, 1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "v.length",
				"expiration_expression": "v.emitter_age > v.length"
			},
			"minecraft:particle_lifetime_events": {
				"creation_event": "spawn"
			},
			"minecraft:particle_initial_speed": 2,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -2, 0],
				"linear_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.size * 0.2", "v.size * 0.2"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 256,
					"texture_height": 16,
					"uv": ["v.icon_offset * 16", "0 * 16"],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_motion_collision": {
				"coefficient_of_restitution": 0.5,
				"collision_radius": 0.2
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["v.damageColor.r", "v.damageColor.g", "v.damageColor.b", 1]
			}
		}
	}
}