{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.dummy": {
            "initial_state": "default",
            "states": {
                "default": {
                    "transitions": [
                        {
                            "damage": "query.hurt_time > 0"
                        }
                    ]
                },
                "damage": {
                    "animations": [
                        "hurt"
                    ],
                    "transitions": [
                        {
                            "default": "q.all_animations_finished" 
                        }
                    ]
                }
            }
        }
    }
}