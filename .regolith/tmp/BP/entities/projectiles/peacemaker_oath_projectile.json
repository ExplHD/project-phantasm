                "default_values": {
                    "max_dropped_ticks": 7,
                    "max_optimized_distance": 96,
                    "use_motion_prediction_hints": true
                }
            }
        },
        "events": {
            "despawn": {
                "add": {
                    "component_groups": [
                        "instant_despawn"
                    ]
                },
                "queue_command": {
                    "command": [
                        "particle ph:peacemaker_oath_hit_effect ~~~",
                        "damage @e[r=2] 28 projectile entity @p[hasitem={item=ph:peacemaker_oath,location=slot.weapon.mainhand}]"
                    ]
                }
            }
        }
    }
