{
    "format_version": "1.20.80",
    "minecraft:entity": {
        "description": {
            "identifier": "ph:peacemaker_oath_projectile",
            "is_spawnable": false,
            "is_summonable": true,
            "is_experimental": false,
            "runtime_identifier": "snowball"
        },
        "component_groups": {
            "instant_despawn": {
                "minecraft:instant_despawn": {}
            }
        },
        "components": {
