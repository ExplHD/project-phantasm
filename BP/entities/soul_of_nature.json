{
	"format_version": "1.20.80",
	"minecraft:entity": {
		"description": {
			"identifier": "ph:soul_of_nature",
			"is_spawnable": true,
			"is_summonable": true,
			"is_experimental": false,
			"properties": {
				"ph:wave_counter": {
					"type": "int",
					"client_sync": false,
					"default": 0,
					"range": [
						0,
						8
					]
				},
				"ph:slash_projectile_counter": {
					"type": "int",
					"client_sync": false,
					"default": 0,
					"range": [
						0,
						4
					]
				}
			}
		},
		"component_groups": {
			"ph:pattern_randomizer": {
				"minecraft:timer": {
					"looping": true,
					"time": [
						5,
						8
					],
					"time_down_event": {
						"event": "randomize_pattern",
						"target": "self"
					}
				}
			},
			"ph:animirra_projectile_spam_charge": {
				"minecraft:timer": {
					"looping": true,
					"time": 0.25,
					"time_down_event": {
						"event": "start_spamming_slash_projectile"
					}
				}
			},
			"ph:ocean_wave_spam_charge_timer": {
				"minecraft:timer": {
					"time": 2,
					"looping": false,
					"time_down_event": {
						"event": "ocean_wave_spam"
					}
				}
			},
			"ph:ocean_wave_spam_loop": {
				"minecraft:timer": {
					"looping": true,
					"time": 0.25,
					"time_down_event": {
						"event": "ocean_wave_spam"
					}
				}
			},
			"ph:vulkan_meteor_crystal_timer": {
				"minecraft:timer": {
					"looping": false,
					"time": 2,
					"time_down_event": {
						"event": "meteor_spawn"
					}
				}
			},
			"ph:armored_phase_checker": {
				"minecraft:environment_sensor": {
					"triggers": [
						{
							"filters": {
								"test": "actor_health",
								"subject": "self",
								"operator": "<",
								"value": 638
							},
							"event": "start_armored_phase"
						}
					]
				}
			},
			"ph:armored_phase": {
				"minecraft:damage_sensor": {
					"triggers": {
						"cause": "all",
						"damage_modifier": 0.6
					}
				}
			}
		},
		"components": {
			"minecraft:boss": {
				"hud_range": 64,
				"should_darken_sky": true,
				"name": "Sealed Soul of Nature"
			},
			"minecraft:collision_box": {
				"width": 0.6,
				"height": 1.4
			},
			"minecraft:experience_reward": {
				"on_death": 1200
			},
			"minecraft:scale": {
				"value": 2.4
			},
			"minecraft:loot": {
				"table": "loot_tables/entities/boss/soul_of_nature.json"
			},
			"minecraft:movement": {
				"value": 0
			},
			"minecraft:knockback_resistance": {
				"value": 999
			},
			"minecraft:health": {
				"value": 850
			},
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": false
			},
			"minecraft:nameable": {
				"allow_name_tag_renaming": false
			},
			"minecraft:type_family": {
				"family": [
					"animirra",
					"boss",
					"soul"
				]
			},
			"minecraft:on_death": {
				"event": "on_death"
			}
		},
		"events": {
			"minecraft:entity_spawned": {
				"add": {
					"component_groups": [
						"ph:pattern_randomizer",
						"ph:armored_phase_checker"
					]
				},
				"queue_command": {
					"command": [
						"title @a[r=64] title Sealed Soul of Nature",
						"title @a[r=64] subtitle The Nature's First Form",
						"playanimation @s animation.soul_of_nature.spawn"
					]
				}
			},
			"randomize_pattern": {
				"randomize": [
					{
						"weight": 1,
						"add": {
							"component_groups": [
								"ph:vulkan_meteor_crystal_timer"
							]
						},
						"queue_command": {
							"command": [
								"playanimation @s animation.soul_of_nature.crystal_1_attack",
								"playsound random.orb @a[r=64] ~~~ 1 1 0.3"
							]
						}
					},
					{
						"weight": 1,
						"add": {
							"component_groups": [
								"ph:ocean_wave_spam_charge_timer"
							]
						},
						"queue_command": {
							"command": [
								"playanimation @s animation.soul_of_nature.crystal_2_attack",
								"playsound random.orb @a[r=64] ~~~ 1 1 0.3"
							]
						}
					},
					{
						"weight": 1,
						"add": {
							"component_groups": [
								"ph:animirra_projectile_spam_charge"
							]
						},
						"queue_command": {
							"command": [
								"playanimation @s animation.soul_of_nature.attack_cube",
								"playsound random.orb @a[r=64] ~~~ 1 1 0.3"
							]
						}
					}
				],
				"remove": {
					"component_groups": [
						"ph:pattern_randomizer"
					]
				}
			},
			"start_spamming_slash_projectile": {
				"sequence": [
					{
						"filters": {
							"test": "int_property",
							"subject": "self",
							"operator": "<",
							"domain": "ph:slash_projectile_counter",
							"value": 4
						},
						"queue_command": {
							"command": [
								"scriptevent ph:boss_summon_projectile 2, ph:land_crystal_slash, custom_sfx.animirra_summon"
							]
						},
						"set_property": {
							"ph:slash_projectile_counter": "query.property('ph:slash_projectile_counter') + 1"
						}
					},
					{
						"filters": {
							"test": "int_property",
							"subject": "self",
							"operator": "==",
							"domain": "ph:slash_projectile_counter",
							"value": 4
						},
						"set_property": {
							"ph:slash_projectile_counter": 0
						},
						"add": {
							"component_groups": [
								"ph:pattern_randomizer"
							]
						},
						"remove": {
							"component_groups": [
								"ph:animirra_projectile_spam_charge"
							]
						}
					}
				]
			},
			"meteor_spawn": {
				"queue_command": {
					"command": "scriptevent ph:boss_summon_meteor 24, 20, 20, ph:animirra_meteor, custom_sfx.animirra_summon"
				},
				"add": {
					"component_groups": [
						"ph:pattern_randomizer"
					]
				},
				"remove": {
					"component_groups": [
						"ph:vulkan_meteor_crystal_timer"
					]
				}
			},
			"ocean_wave_spam": {
				"sequence": [
					{
						"filters": {
							"test": "int_property",
							"subject": "self",
							"operator": "<",
							"domain": "ph:wave_counter",
							"value": 8
						},
						"queue_command": {
							"command": [
								"scriptevent ph:boss_summon_projectile 1, ph:ocean_crystal_wave, custom_sfx.animirra_summon"
							]
						},
						"set_property": {
							"ph:wave_counter": "query.property('ph:wave_counter') + 1"
						},
						"add": {
							"component_groups": [
								"ph:ocean_wave_spam_loop"
							]
						},
						"remove": {
							"component_groups": [
								"ph:ocean_wave_spam_charge_timer"
							]
						}
					},
					{
						"filters": {
							"test": "int_property",
							"subject": "self",
							"operator": "==",
							"domain": "ph:wave_counter",
							"value": 8
						},
						"set_property": {
							"ph:wave_counter": 0
						},
						"add": {
							"component_groups": [
								"ph:pattern_randomizer"
							]
						},
						"remove": {
							"component_groups": [
								"ph:ocean_wave_spam_loop"
							]
						}
					}
				]
			},
			"start_armored_phase": {
				"remove": {
					"component_groups": [
						"ph:armored_phase_checker"
					]
				},
				"add": {
					"component_groups": [
						"ph:armored_phase"
					]
				},
				"queue_command": {
					"command": [
						"tellraw @a {\"rawtext\":[{\"text\":\"The souls presence is getting stronger...\"}]}",
						"summon ph:land_crystal ~9~~9",
						"summon ph:land_crystal ~-9~~-9",
						"summon ph:ocean_crystal ~9~~-9",
						"summon ph:ocean_crystal ~-9~~9"
					]
				}
			},
			"on_death": {
				"queue_command": {
					"command": [
						"event entity @e[type=ph:land_crystal,r=64] despawn",
						"event entity @e[type=ph:ocean_crystal,r=64] despawn"
					]
				}
			}
		}
	}
}