{
    "format_version": "1.20.80",
    "minecraft:entity": {
        "description": {
            "identifier": "ph:suspicious_crimson_eye",
            "is_spawnable": false,
            "is_summonable": true,
            "is_experimental": false
        },
        "component_groups": {
            "ph:spawn_timer": {
                "minecraft:timer": {
                    "time": 3,
                    "looping": true,
                    "time_down_event": {
                        "event": "ph:boss_spawned"
                    }
                }
            },
            "ph:despawn_timer": {
                "minecraft:timer": {
                    "time": 3,
                    "looping": true,
                    "time_down_event": {
                        "event": "despawn"
                    }
                }
            },
            "despawn": {
                "minecraft:instant_despawn": {}
            }
        },
        "components": {
            "minecraft:health": {
                "value": 5
            },
            "minecraft:collision_box": {
                "height": 0.8,
                "width": 0.8
            },
            "minecraft:physics": {
                "has_collision": false,
                "has_gravity": false
            },
            "minecraft:damage_sensor": {
                "triggers": {
                    "cause": "all",
                    "deals_damage": false
                }
            },
            "minecraft:type_family": {
                "family": [
                    "inanimate",
                    "crimson_eye"
                ]
            },
            "minecraft:knockback_resistance": {
                "value": 100
            },
            "minecraft:pushable": {
                "is_pushable": false,
                "is_pushable_by_piston": false
            },
            "minecraft:behavior.look_at_entity": {
                "look_distance": 32,
                "probability": 1,
                "look_time": [
                    30,
                    60
                ],
                "priority": 0
            }
        },
        "events": {
            "minecraft:entity_spawned": {
                "queue_command": {
                    "command": [
                        "camera @a[r=64] set minecraft:free ease 0 in_out_sine pos ^^2^9 facing @s"
                    ]
                },
                "add": {
                    "component_groups": [
                        "ph:spawn_timer"
                    ]
                }
            },
            "ph:boss_spawned": {
                "add": {
                    "component_groups": [
                        "ph:despawn_timer"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "ph:spawn_timer"
                    ]
                },
                "queue_command": {
                    "command": [
                        "camera @a[r=64] set minecraft:free ease 1.5 in_out_sine pos ^^4^12 facing @s",
                        "particle ph:cruxshaper_smash_explosion ~~1.5~",
                        "summon ph:punicea_crimson_eye ~~-0.6~ facing @p[r=64]",
                        "playsound random.explode @a[r=64] ~~~ 1 1 0.3"
                    ]
                }
            },
            "despawn": {
                "add": {
                    "component_groups": [
                        "despawn"
                    ]
                },
                "queue_command": {
                    "command": [
                        "camera @a[r=64] clear"
                    ]
                }
            }
        }
    }
}