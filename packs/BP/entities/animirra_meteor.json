{
    "format_version": "1.21.100",
    "minecraft:entity": {
        "description": {
            "identifier": "ph:animirra_meteor",
            "is_spawnable": false,
            "is_summonable": true,
            "is_experimental": false
        },
        "component_groups": {
            "ph:add_physics": {
                "minecraft:physics": {
                    "has_collision": true,
                    "has_gravity": true
                },
                "minecraft:timer": {
                    "time": [ 7, 9.5 ],
                    "looping": true,
                    "time_down_event": {
                        "event": "explode"
                    }
                }
            },
            "despawn": {
                "minecraft:instant_despawn": {}
            }
        },
        "components": {
            "minecraft:health": {
                "value": 400
            },
            "minecraft:collision_box": {
                "height": 0.5,
                "width": 0.5
            },
            "minecraft:physics": {
                "has_collision": true,
                "has_gravity": false
            },
            "minecraft:timer": {
                "looping": false,
                "time": 1.5,
                "time_down_event": {
                    "event": "add_physics"
                }
            },
            "minecraft:damage_sensor": {
                "triggers": [
                    {
                        "cause": "fall",
                        "deals_damage": "yes",
                        "on_damage": {
                            "event": "explode"
                        }
                    },
                    {
                        "cause": "all",
                        "deals_damage": "no"
                    }
                ]
            }
        },
        "events": {
            "minecraft:entity_spawned": {
                "queue_command": {
                    "command": [
                        "particle ph:animitta_warning_signs ~~-19.8~"
                    ]
                }
            },
            "add_physics": {
                "add": {
                    "component_groups": [
                        "ph:add_physics"
                    ]
                }
            },
            "explode": {
                "queue_command": {
                    "command": [
                        "damage @e[rm=0.1,r=4,family=!animirra] 20 entity_attack entity @s",
                        "playsound entity.meteor_impact @a[r=64]",
                        "particle ph:animitta_meteor_impact ~~~"
                    ]
                },
                "trigger": "despawn"
            },
            "despawn": {
                "add": {
                    "component_groups": [
                        "despawn"
                    ]
                }
            }
        }
    }
}