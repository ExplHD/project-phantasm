{
  "format_version": "1.26.10",
  "minecraft:entity": {
    "description": {
      "identifier": "ph:ancient_sentinel",
      "spawn_category": "monster",
      "is_spawnable": true,
      "is_summonable": true,
      "properties": {
        "ph:sentinel_state": {
          "type": "enum",
          "values": [
            "dormant",
            "awakening",
            "active",
            "ball",
            "roll",
            "unrolling"
          ],
          "default": "dormant",
          "client_sync": true
        },
        // World yaw of the current Mirror Charge direction, drives the RP roll axis.
        "ph:roll_yaw": {
          "type": "float",
          "range": [-180.0, 180.0],
          "default": 0.0,
          "client_sync": true
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["monster", "mob", "sentinel", "ancient_sentinel"]
      },
      "minecraft:physics": {},
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_damage_blocks": true,
        "avoid_water": true
      },
      "minecraft:collision_box": {
        "width": 1.3,
        "height": 1.8
      },
      "minecraft:movement": {
        "value": 0.24
      },
      "minecraft:health": {
        "value": 900,
        "max": 900
      },
      "minecraft:scale": {
        "value": 2
      },
      "minecraft:attack": {
        "damage": 14
      },
      "minecraft:knockback_resistance": {
        "value": 0.5
      },
      "minecraft:ambient_sound_interval": {
        "value": 8,
        "range": 6
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self"
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:pushable_by_entity": {},
      "minecraft:pushable_by_block": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:nameable": {},
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 120 : 0"
      },
      // Bridging goal so it never drowns while dormant in a flooded ruin.
      "minecraft:behavior.float": {
        "priority": 0
      }
    },
    "component_groups": {
      // Combat brain, only mounted once it has woken up.
      "ph:combat": {
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1,
          "within_radius": 30.0,
          "must_see": false,
          "reselect_targets": true,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 30
            }
          ]
        },
        "minecraft:behavior.melee_box_attack": {
          "priority": 2,
          "track_target": true,
          "cooldown_time": 1.4,
          "speed_multiplier": 1.15,
          "horizontal_reach": 1.5
        },
        "minecraft:behavior.hurt_by_target": {
          "priority": 3
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 0.75
        },
        "minecraft:behavior.look_at_player": {
          "priority": 7,
          "look_distance": 8.0,
          "probability": 0.5
        },
        "minecraft:behavior.random_look_around": {
          "priority": 8
        }
      },
      // Sleeping statue: locked in place, immune, and any damage is the wake trigger.
      "ph:dormant": {
        "minecraft:movement": {
          "value": 0.0
        },
        "minecraft:body_rotation_blocked": {},
        "minecraft:knockback_resistance": {
          "value": 1.0
        },
        "minecraft:ambient_sound_interval": {
          "value": 300,
          "range": 120
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "all",
              "deals_damage": "no",
              "on_damage": {
                "event": "ph:awaken"
              }
            }
          ]
        }
      },
      "ph:awakening": {
        "minecraft:movement": {
          "value": 0.0
        },
        "minecraft:body_rotation_blocked": {},
        "minecraft:ambient_sound_interval": {
          "value": 1,
          "range": 0
        }
      },
      // Curled into a ball for a scripted attack; melee chip damage is zeroed so the
      // only damage during these states comes from the attacks themselves.
      "ph:ball": {
        "minecraft:movement": {
          "value": 0.0
        },
        "minecraft:body_rotation_blocked": {},
        "minecraft:knockback_resistance": {
          "value": 1.0
        },
        "minecraft:collision_box": {
          "width": 1.5,
          "height": 1.5
        },
        // No auto step: ledges count as walls and must bounce, not climb.
        "minecraft:variable_max_auto_step": {
          "base_value": 0.0,
          "controlled_value": 0.0,
          "jump_prevented_value": 0.0
        },
        "minecraft:attack": {
          "damage": 0
        }
      },
      // Mirror Charge: sulfur-cube style ball physics. Negative knockback resistance
      // (as vanilla sulfur cubes use) amplifies player hits, so batting the ball
      // visibly kicks it away in the new direction.
      "ph:roll": {
        "minecraft:movement": {
          "value": 0.0
        },
        "minecraft:body_rotation_blocked": {},
        "minecraft:knockback_resistance": {
          "value": -1.0
        },
        "minecraft:collision_box": {
          "width": 1.5,
          "height": 1.5
        },
        "minecraft:variable_max_auto_step": {
          "base_value": 0.0,
          "controlled_value": 0.0,
          "jump_prevented_value": 0.0
        },
        "minecraft:attack": {
          "damage": 0
        }
      },
      // Berserk phase at half health.
      "ph:enraged": {
        "minecraft:attack": {
          "damage": 18
        },
        "minecraft:movement": {
          "value": 0.3
        }
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": ["ph:dormant"]
        },
        "set_property": {
          "ph:sentinel_state": "dormant"
        }
      },
      "ph:awaken": {
        "remove": {
          "component_groups": ["ph:dormant", "ph:enraged"]
        },
        "add": {
          "component_groups": ["ph:awakening"]
        },
        "set_property": {
          "ph:sentinel_state": "awakening"
        }
      },
      "ph:wake_up": {
        "remove": {
          "component_groups": ["ph:awakening"]
        },
        "add": {
          "component_groups": ["ph:combat"]
        },
        "set_property": {
          "ph:sentinel_state": "active"
        }
      },
      "ph:start_ball": {
        "remove": {
          "component_groups": ["ph:combat", "ph:roll"]
        },
        "add": {
          "component_groups": ["ph:ball"]
        },
        "set_property": {
          "ph:sentinel_state": "ball"
        }
      },
      "ph:start_roll": {
        "remove": {
          "component_groups": ["ph:combat", "ph:ball"]
        },
        "add": {
          "component_groups": ["ph:roll"]
        },
        "set_property": {
          "ph:sentinel_state": "roll"
        }
      },
      "ph:resume_combat": {
        "remove": {
          "component_groups": ["ph:ball", "ph:roll"]
        },
        "set_property": {
          "ph:sentinel_state": "unrolling"
        }
      },
      "ph:end_unroll": {
        "add": {
          "component_groups": ["ph:combat"]
        },
        "set_property": {
          "ph:sentinel_state": "active"
        }
      },
      "ph:rage": {
        "add": {
          "component_groups": ["ph:enraged"]
        }
      }
    }
  }
}
