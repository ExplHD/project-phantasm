{
	"format_version": "1.26.0",
	"minecraft:entity": {
		"description": {
			"identifier": "ph:polaris_node",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false
		},
		"component_groups": {
			"despawn": {
				"minecraft:instant_despawn": {}
			}
		},
		"components": {
			// Charger node for The Phase Collapse. Breaking every node cancels the ultimate.
			"minecraft:health": {
				"value": 40,
				"max": 40
			},
			"minecraft:collision_box": {
				"width": 0.9,
				"height": 1.3
			},
			"minecraft:physics": {
				"has_gravity": true,
				"has_collision": true
			},
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": false
			},
			"minecraft:knockback_resistance": {
				"value": 1
			},
			"minecraft:type_family": {
				"family": [
					"polaris_node",
					"titan_ridge",
					"mob"
				]
			},
			"minecraft:fire_immune": {},
			"minecraft:damage_sensor": {
				"triggers": [
					{
						"cause": "all",
						"deals_damage": "no",
						"on_damage": {
							"filters": {
								"test": "is_family",
								"subject": "other",
								"value": "titan_ridge"
							}
						}
					},
					{ "cause": "fall", "deals_damage": "no" },
					{ "cause": "suffocation", "deals_damage": "no" }
				]
			},
			// Failsafe: the collapse runs 20s, a node that outlives it removes itself.
			"minecraft:timer": {
				"looping": false,
				"time": 30,
				"time_down_event": {
					"event": "despawn",
					"target": "self"
				}
			}
		},
		"events": {
			"despawn": {
				"add": {
					"component_groups": [
						"despawn"
					]
				}
			}
		}
	}
}
