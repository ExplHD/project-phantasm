{
	"format_version": "1.26.0",
	"minecraft:entity": {
		"description": {
			"identifier": "ph:forge_trooper",
			"is_spawnable": true,
			"is_summonable": true,
			"is_experimental": false,
			"spawn_category": "monster"
		},
		"component_groups": {
			"ph:base_state": {
				"minecraft:spell_effects": {
					"add_effects": [
						{
							"effect": "slow_falling",
							"duration": 9999999,
							"ambient": true,
							"visible": false
						}
					]
				}
			},
			"ph:variant_gold": {
				"minecraft:variant": {
					"value": 0
				},
				"minecraft:experience_reward": {
					"on_death": "query.last_hit_by_player ? 20 : 0"
				},
				"minecraft:loot": {
					"table": "loot_tables/entities/forge_trooper_gold.json"
				}
			},
			"ph:variant_plasma": {
				"minecraft:variant": {
					"value": 1
				},
				"minecraft:experience_reward": {
					"on_death": "query.last_hit_by_player ? 10 : 0"
				},
				"minecraft:loot": {
					"table": "loot_tables/entities/forge_trooper_plasma.json"
				}
			},
			"ph:variant_amber": {
				"minecraft:variant": {
					"value": 2
				},
				"minecraft:experience_reward": {
					"on_death": "query.last_hit_by_player ? 10 : 0"
				},
				"minecraft:loot": {
					"table": "loot_tables/entities/forge_trooper_amber.json"
				}
			}
		},
		"components": {
			"minecraft:health": {
				"value": 100,
				"max": 100
			},
			"minecraft:collision_box": {
				"width": 0.9,
				"height": 2.35
			},
			"minecraft:movement": {
				"value": 0.28
			},
			"minecraft:navigation.walk": {
				"can_path_over_water": true,
				"avoid_water": true,
				"avoid_damage_blocks": true,
				"can_pass_doors": true
			},
			"minecraft:movement.basic": {
				"max_turn": 30
			},
			// 8-block leap. jump_power 1 ≈ 7-8 blocks up (vanilla baseline is 0.42 ≈ 1.25 blocks).
			"minecraft:jump.static": {
				"jump_power": 1
			},
			"minecraft:physics": {
				"has_gravity": true,
				"has_collision": true
			},
			"minecraft:knockback_resistance": {
				"value": 0.8
			},
			"minecraft:pushable": {
				"is_pushable": true,
				"is_pushable_by_piston": true
			},
			// 20% damage reduction on every source; falls are fully negated (slow faller).
			"minecraft:damage_sensor": {
				"triggers": [
					{
						"cause": "fall",
						"deals_damage": "no"
					},
					{
						"damage_multiplier": 0.8
					}
				]
			},
			"minecraft:hurt_on_condition": {
				"damage_conditions": [
					{
						"filters": {
							"test": "in_lava",
							"subject": "self"
						},
						"cause": "lava",
						"damage_per_tick": 4
					}
				]
			},
			"minecraft:type_family": {
				"family": [
					"monster",
					"forge_trooper",
					"titan_ridge",
					"mob"
				]
			},
			"minecraft:experience_reward": {
				"on_death": "query.last_hit_by_player ? 10 : 0"
			},
			"minecraft:loot": {
				"table": "loot_tables/entities/forge_trooper.json"
			},
			"minecraft:behavior.float": {
				"priority": 0
			},
			"minecraft:behavior.nearest_attackable_target": {
				"priority": 1,
				"within_radius": 24.0,
				"must_see": false,
				"reselect_targets": true,
				// Players and every other mob; the Titan Ridge faction (drones, Titan Core, troopers) is spared.
				"entity_types": [
					{
						"filters": {
							"test": "is_family",
							"subject": "other",
							"value": "player"
						},
						"max_dist": 24
					},
					{
						"filters": {
							"all_of": [
								{ "test": "is_family", "subject": "other", "value": "mob" },
								{ "test": "is_family", "subject": "other", "operator": "!=", "value": "titan_ridge" }
							]
						},
						"max_dist": 24
					}
				]
			},
			"minecraft:behavior.hurt_by_target": {
				"priority": 2,
				"entity_types": {
					"filters": { "test": "is_family", "subject": "other", "operator": "!=", "value": "titan_ridge" }
				}
			},
			"minecraft:behavior.move_towards_target": {
				"priority": 3,
				"speed_multiplier": 1.0
			},
			"minecraft:behavior.look_at_target": {
				"priority": 4,
				"look_distance": 10.0
			},
			"minecraft:behavior.random_stroll": {
				"priority": 5,
				"speed_multiplier": 0.6
			},
			"minecraft:behavior.random_look_around": {
				"priority": 6
			},
			"minecraft:follow_range": {
				"value": 24
			},
			"minecraft:despawn": {
				"despawn_from_distance": {}
			},
			"minecraft:nameable": {}
		},
		"events": {
			"minecraft:entity_spawned": {
				"randomize": [
					{
						"weight": 20,
						"trigger": "ph:spawn_gold"
					},
					{
						"weight": 40,
						"trigger": "ph:spawn_plasma"
					},
					{
						"weight": 40,
						"trigger": "ph:spawn_amber"
					}
				]
			},
			"ph:spawn_gold": {
				"add": {
					"component_groups": [
						"ph:base_state",
						"ph:variant_gold"
					]
				}
			},
			"ph:spawn_plasma": {
				"add": {
					"component_groups": [
						"ph:base_state",
						"ph:variant_plasma"
					]
				}
			},
			"ph:spawn_amber": {
				"add": {
					"component_groups": [
						"ph:base_state",
						"ph:variant_amber"
					]
				}
			}
		}
	}
}
