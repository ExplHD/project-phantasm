{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.lizardman": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"animations": ["idle"],
					"blend_transition": 0.3,
					"transitions": [
						{"attack": "query.is_delayed_attacking"},
						{"run": "query.has_target && query.modified_move_speed > 0.1"},
						{"walk": "query.modified_move_speed > 0.1"}
					]
				},
				"walk": {
					"animations": ["walk"],
					"blend_transition": 0.3,
					"transitions": [
						{"attack": "query.is_delayed_attacking"},
						{"run": "query.has_target && query.modified_move_speed > 0.1"},
						{"idle": "query.modified_move_speed < 0.05"}
					]
				},
				"run": {
					"animations": ["run"],
					"blend_transition": 0.25,
					"transitions": [
						{"attack": "query.is_delayed_attacking"},
						{"walk": "!query.has_target && query.modified_move_speed > 0.05"},
						{"idle": "query.modified_move_speed < 0.05"}
					]
				},
				"attack": {
					"animations": ["attack"],
					"blend_transition": 0.15,
					"transitions": [
						{"run": "query.all_animations_finished && query.has_target && query.modified_move_speed > 0.1"},
						{"walk": "query.all_animations_finished && query.modified_move_speed > 0.1"},
						{"idle": "query.all_animations_finished"}
					]
				}
			}
		}
	}
}
