{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.plasmoid_drone": {
            "initial_state": "idle",
            "states": {
                "idle": {
                    "transitions": [
                        {
                            "move": "query.modified_move_speed > 0.25"
                        }
                    ]
                },
                "move": {
                    "animations": [
                        "move"
                    ],
                    "transitions": [
                        {
                            "idle": "query.modified_move_speed < 0.25"
                        }
                    ]
                }
            }
        },
        "controller.animation.plasmoid_drone.shoot": {
            "initial_state": "default",
            "states": {
                "default": {
                    "transitions": [
                        {
                            "charge": "query.has_target"
                        }
                    ]
                },
                "charge": {
                    "animations": [
                        "shoot"
                    ],
                    "transitions": [
                        {
                            "default": "!query.has_target"
                        }
                    ]
                }
            }
        }
    }
}