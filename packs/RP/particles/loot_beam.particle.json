{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:loot_beam",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/loot_beam/loot_beam"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0
			},
			"minecraft:emitter_shape_point": {
				"offset": [
					0,
					"v.height * v.scale + 0.3",
					0
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1.25
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.18 * v.scale",
					"v.height * v.scale"
				],
				"facing_camera_mode": "rotate_y",
				"uv": {
					"texture_width": 16,
					"texture_height": 64,
					"uv": [
						0,
						0
					],
					"uv_size": [
						16,
						64
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"v.color.r",
					"v.color.g",
					"v.color.b",
					"v.alpha * math.clamp(math.min(v.particle_age, v.particle_lifetime - v.particle_age) / 0.25, 0, 1)"
				]
			}
		}
	}
}