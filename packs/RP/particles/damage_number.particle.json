{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:damage_number",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/damage_indicator/number"
			}
		},
		"curves": {
			"variable.size": {
				"type": "linear",
				"input": "v.emitter_age",
				"horizontal_range": "v.length",
				"nodes": [0, 1, 1, 1, 1, 0.75, 0]
			}
		},
		"events": {
			"spawn": {
				"expression": "v.number  = v.number + 1;"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.number = 1;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "v.digits"
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": "v.length + 1"
			},
			"minecraft:emitter_shape_point": {
				"offset": ["((-(v.digits / 4.5)) + (v.number / 3)) * math.cos(v.roty)", 0, "((-(v.digits / 4.5)) + (v.number / 3)) * math.sin(v.roty)"],
				"direction": [0, 1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "v.number + v.length",
				"expiration_expression": "v.emitter_age > v.length"
			},
			"minecraft:particle_lifetime_events": {
				"creation_event": "spawn"
			},
			"minecraft:particle_initial_speed": 2,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -2, 0],
				"linear_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.size * 0.2", "v.size * 0.2"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 160,
					"texture_height": 16,
					"uv": [
						"(((v.particle_lifetime - v.length) - 1) < 1 ? v.floored : ((v.particle_lifetime - v.length) - 1) < 2 ? v.floored_tenths : ((v.particle_lifetime - v.length) - 1) < 3 ? v.floored_hundreths : ((v.particle_lifetime - v.length) - 1) < 4 ? v.floored_thousandths : ((v.particle_lifetime - v.length) - 1) < 5 ? v.floored_ten_thousandths : v.floored_hundred_thousandths) * 16",
						"0 * 16"
					],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_motion_collision": {
				"coefficient_of_restitution": 0.5,
				"collision_radius": 0.2
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["v.damageColor.r", "v.damageColor.g", "v.damageColor.b", 1]
			}
		}
	}
}
