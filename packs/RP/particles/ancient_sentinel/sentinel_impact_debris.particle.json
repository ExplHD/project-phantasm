{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:sentinel_impact_debris",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/campfire_smoke"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "math.clamp(v.radius * 2.5, 8, 18)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_disc": {
				"offset": [
					0,
					0.4,
					0
				],
				"radius": 1.0,
				"plane_normal": "y",
				"direction": [
					"math.random(-1, 1)",
					"math.random(1.4, 2.4)",
					"math.random(-1, 1)"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1.0, 1.6)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0, 360)",
				"rotation_rate": "math.random(-400, 400)"
			},
			"minecraft:particle_initial_speed": "math.random(5, 9)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					-24,
					0
				],
				"linear_drag_coefficient": 0.4
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.1,
				"coefficient_of_restitution": 0.25,
				"collision_drag": 6
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.08 + v.particle_random_3 * 0.1",
					"0.08 + v.particle_random_3 * 0.1"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 192,
					"uv": [
						0,
						"math.floor(v.particle_random_1 * 12) * 16"
					],
					"uv_size": [
						16,
						16
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					0.5,
					0.42,
					0.35,
					"math.clamp((v.particle_lifetime - v.particle_age) / 0.3, 0, 1)"
				]
			}
		}
	}
}
