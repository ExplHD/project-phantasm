{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:sentinel_slam_telegraph_edge",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/ancient_sentinel/sentinel_mark"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "math.clamp(v.radius * 4, 12, 32)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_disc": {
				"offset": [
					0,
					0.15,
					0
				],
				"radius": "v.radius",
				"plane_normal": "y",
				"surface_only": true,
				"direction": "inwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.35, 0.5)"
			},
			"minecraft:particle_initial_speed": "math.random(0.4, 0.9)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					1.2,
					0
				],
				"linear_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.14 * (1 - v.particle_age / v.particle_lifetime) + 0.04",
					"0.14 * (1 - v.particle_age / v.particle_lifetime) + 0.04"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [
						0,
						0
					],
					"uv_size": [
						16,
						16
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFD27A",
						"0.5": "#FFFF6A30",
						"1.0": "#00C03018"
					}
				}
			}
		}
	}
}
