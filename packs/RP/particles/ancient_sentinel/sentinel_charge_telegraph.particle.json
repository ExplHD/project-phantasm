{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:sentinel_charge_telegraph",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/ancient_sentinel/sentinel_mark"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_point": {
				"offset": [
					0,
					0.06,
					0
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.7 + v.delay"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"(v.particle_age < v.delay) ? 0 : 0.28 + 0.2 * math.clamp((v.particle_age - v.delay) / 0.1, 0, 1) - 0.12 * math.clamp((v.particle_age - v.delay) / 0.7, 0, 1)",
					"(v.particle_age < v.delay) ? 0 : 0.28 + 0.2 * math.clamp((v.particle_age - v.delay) / 0.1, 0, 1) - 0.12 * math.clamp((v.particle_age - v.delay) / 0.7, 0, 1)"
				],
				"facing_camera_mode": "emitter_transform_xz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [
						0,
						0
					],
					"uv_size": [
						16,
						16
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					1.0,
					0.36,
					0.14,
					"(v.particle_age < v.delay) ? 0 : math.clamp((v.particle_lifetime - v.particle_age) / 0.25, 0, 1) * 0.95"
				]
			}
		}
	}
}
