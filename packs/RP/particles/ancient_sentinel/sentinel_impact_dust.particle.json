{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:sentinel_impact_dust",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/campfire_smoke"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "math.clamp(v.radius * 5, 16, 36)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_disc": {
				"offset": [
					0,
					0.3,
					0
				],
				"radius": 1.2,
				"plane_normal": "y",
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.9, 1.4)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0, 360)",
				"rotation_rate": "math.random(-60, 60)"
			},
			"minecraft:particle_initial_speed": "v.radius * math.random(2.6, 3.6)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					0.6,
					0
				],
				"linear_drag_coefficient": 3.2
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.45 + 0.6 * v.particle_age / v.particle_lifetime",
					"0.45 + 0.6 * v.particle_age / v.particle_lifetime"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 192,
					"uv": [
						0,
						"math.floor(v.particle_random_1 * 12) * 16"
					],
					"uv_size": [
						16,
						16
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#D0A89078",
						"0.6": "#9078644F",
						"1.0": "#00605040"
					}
				}
			}
		}
	}
}
