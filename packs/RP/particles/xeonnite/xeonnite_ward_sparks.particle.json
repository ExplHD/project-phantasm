{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:xeonnite_ward_sparks",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 14
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_shape_point": {
				"direction": [
					"v.dir.x + math.random(-0.7, 0.7)",
					"v.dir.y + math.random(-0.1, 0.8)",
					"v.dir.z + math.random(-0.7, 0.7)"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.25, 0.45)"
			},
			"minecraft:particle_initial_speed": "math.random(4, 7)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					-12,
					0
				],
				"linear_drag_coefficient": 2.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					0.04,
					"0.22 * (1 - (v.particle_age / v.particle_lifetime))"
				],
				"facing_camera_mode": "direction_y",
				"direction": {
					"mode": "derive_from_velocity",
					"min_speed_threshold": 0.01
				},
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [
						4,
						2
					],
					"uv_size": [
						4,
						4
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "(v.particle_age / v.particle_lifetime)",
					"gradient": {
						"0.0": "#FFFFC080",
						"0.4": "#FFC06020",
						"1.0": "#FF5A4A40"
					}
				}
			}
		}
	}
}
