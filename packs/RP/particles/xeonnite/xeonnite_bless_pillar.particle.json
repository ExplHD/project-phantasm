{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:xeonnite_bless_pillar",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "90 * (1 - v.emitter_age / 1.4)",
				"max_particles": 140
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1.4
			},
			"minecraft:emitter_shape_disc": {
				"plane_normal": "y",
				"radius": 0.55,
				"direction": [
					"math.random(-0.08, 0.08)",
					1,
					"math.random(-0.08, 0.08)"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.7, 1.3)"
			},
			"minecraft:particle_initial_speed": "math.random(5, 9)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 1.6
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					0.07,
					"0.45 * (1 - (v.particle_age / v.particle_lifetime))"
				],
				"facing_camera_mode": "direction_y",
				"direction": {
					"mode": "derive_from_velocity",
					"min_speed_threshold": 0.01
				},
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [
						4,
						2
					],
					"uv_size": [
						4,
						4
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "(v.particle_age / v.particle_lifetime)",
					"gradient": {
						"0.0": "#FFFFF4D8",
						"0.3": "#FFF6953E",
						"1.0": "#00B35B0A"
					}
				}
			}
		}
	}
}
