{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:auric_apex_flash",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/auric_apex"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.3
			},
			"minecraft:particle_initial_spin": {
				"rotation": 0
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"(v.scale ?? 1) * 1.1 * math.min(1, (v.particle_age / v.particle_lifetime) * 8) * (1 - (v.particle_age / v.particle_lifetime) * 0.6)",
					"(v.scale ?? 1) * 2.2 * math.min(1, (v.particle_age / v.particle_lifetime) * 8) * (1 - (v.particle_age / v.particle_lifetime) * 0.4)"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [
						0,
						0
					],
					"uv_size": [
						64,
						64
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "(v.particle_age / v.particle_lifetime)",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.5": "#FFFFF0D0",
						"1.0": "#00FFC060"
					}
				}
			}
		}
	}
}
