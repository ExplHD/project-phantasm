{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:auric_apex_sparks",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/auric_apex"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 16
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.1,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.2, 0.45)"
			},
			"minecraft:particle_initial_speed": "math.random(5, 11) * (v.scale ?? 1)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					-6,
					0
				],
				"linear_drag_coefficient": 3.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.035 * (1 - (v.particle_age / v.particle_lifetime))",
					"0.24 * (1 - (v.particle_age / v.particle_lifetime))"
				],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [
						48,
						64
					],
					"uv_size": [
						16,
						16
					]
				},
				"direction": {
					"mode": "derive_from_velocity",
					"min_speed_threshold": 0.01
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_random_1",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.5": "#FFFFD060",
						"1.0": "#FFF08A20"
					}
				}
			}
		}
	}
}
