{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:auric_apex_charge",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/auric_apex"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 3
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_sphere": {
				"radius": "0.45 + 0.35 * (v.charge ?? 0)",
				"surface_only": true,
				"direction": "inwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.18
			},
			"minecraft:particle_initial_speed": "(2.5 + 2 * (v.charge ?? 0))",
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.025 * (1 - (v.particle_age / v.particle_lifetime) * 0.5)",
					"0.13 * (1 - (v.particle_age / v.particle_lifetime) * 0.5)"
				],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [
						48,
						64
					],
					"uv_size": [
						16,
						16
					]
				},
				"direction": {
					"mode": "derive_from_velocity",
					"min_speed_threshold": 0.01
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "(v.particle_age / v.particle_lifetime)",
					"gradient": {
						"0.0": "#00FFC040",
						"0.3": "#FFFFD070",
						"1.0": "#FFFFFFFF"
					}
				}
			}
		}
	}
}
