{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:interstellaris_nova",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/aura_slash/aura_mote"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.size = v.size ?? 3;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "math.min(60, 10 + v.size * 6)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.2,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.3,0.55)"
			},
			"minecraft:particle_initial_speed": "v.size * math.random(2.2,3.6)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 3.2
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.06*(1-v.particle_age/v.particle_lifetime)",
					"0.3*(1-v.particle_age/v.particle_lifetime)"
				],
				"facing_camera_mode": "lookat_direction",
				"direction": {
					"mode": "derive_from_velocity",
					"min_speed_threshold": 0.01
				},
				"uv": {
					"texture_width": 16,
					"texture_height": 8,
					"uv": [
						8,
						0
					],
					"uv_size": [
						8,
						8
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_random_1",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.45": "#FF6EECF0",
						"1.0": "#FFFFD630"
					}
				}
			}
		}
	}
}
