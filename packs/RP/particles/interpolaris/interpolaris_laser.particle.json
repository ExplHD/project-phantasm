{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:interpolaris_laser",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/interpolaris/glow"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.length = v.length ?? 4;v.width = v.width ?? 1;v.life = v.life ?? 0.25;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "math.min(600, 12 + v.length * 24)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "v.life"
			},
			"minecraft:particle_initialization": {
				"per_update_expression": "v.d = v.particle_random_1 * v.length;v.ang = v.d * 280 + v.particle_age * 900 + (v.particle_random_2 > 0.81 ? 180 : 0);v.rad = v.particle_random_2 > 0.62 ? 0.3 * v.width * (1 - 0.5 * (v.particle_age/v.particle_lifetime)) : 0;v.show = v.particle_age >= v.particle_random_1 * 0.07 ? 1 : 0;"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [
					"v.dir.x * v.d + v.u.x * math.cos(v.ang) * v.rad + v.w.x * math.sin(v.ang) * v.rad",
					"v.dir.y * v.d + v.u.y * math.cos(v.ang) * v.rad + v.w.y * math.sin(v.ang) * v.rad",
					"v.dir.z * v.d + v.u.z * math.cos(v.ang) * v.rad + v.w.z * math.sin(v.ang) * v.rad"
				]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"v.show * (v.particle_random_2 < 0.4 ? 0.17 : (v.particle_random_2 < 0.62 ? 0.46 : 0.11)) * v.width * (1 - (v.particle_age/v.particle_lifetime) * (v.particle_age/v.particle_lifetime))",
					"v.show * (v.particle_random_2 < 0.4 ? 0.17 : (v.particle_random_2 < 0.62 ? 0.46 : 0.11)) * v.width * (1 - (v.particle_age/v.particle_lifetime) * (v.particle_age/v.particle_lifetime))"
				],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 32,
					"texture_height": 32,
					"uv": [
						0,
						0
					],
					"uv_size": [
						32,
						32
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"v.particle_random_2 < 0.4 ? 0.95 : (v.particle_random_2 < 0.62 ? 0.23 : 0.69)",
					"v.particle_random_2 < 0.4 ? 0.89 : (v.particle_random_2 < 0.62 ? 0.66 : 0.49)",
					"v.particle_random_2 < 0.4 ? 1.0 : (v.particle_random_2 < 0.62 ? 0.98 : 1.0)",
					"v.particle_random_2 < 0.4 ? 1.0 : (v.particle_random_2 < 0.62 ? 0.4 : 0.95)"
				]
			}
		}
	}
}
