{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:interpolaris_cast_motes",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/interpolaris/spark"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.size = v.size ?? 0.7;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 14
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_sphere": {
				"radius": "v.size",
				"surface_only": true,
				"direction": "inwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.16,0.24)"
			},
			"minecraft:particle_initial_speed": "v.size * 4.2",
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.035*(1+v.size)",
					"0.18*v.size*(1-0.6*(v.particle_age/v.particle_lifetime))"
				],
				"facing_camera_mode": "lookat_direction",
				"direction": {
					"mode": "derive_from_velocity",
					"min_speed_threshold": 0.01
				},
				"uv": {
					"texture_width": 8,
					"texture_height": 8,
					"uv": [
						0,
						0
					],
					"uv_size": [
						8,
						8
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_random_3",
					"gradient": {
						"0.0": "#FFF2E4FF",
						"0.5": "#FFD0A4FF",
						"1.0": "#FF3AA8FA"
					}
				}
			}
		}
	}
}
