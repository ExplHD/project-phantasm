{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:interpolaris_glitch_tear",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/interpolaris/glitch"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.size = v.size ?? 1;v.height = v.height ?? 1.8;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 16
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.18,0.32)"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [
					"(math.abs(math.sin(math.floor(v.particle_age*16)*78.233+(v.particle_random_1*13.1+v.particle_random_3*7.7)*437.1))-0.5)*1.6*v.size",
					"v.particle_random_2*v.height",
					"(v.particle_random_3-0.5)*0.8*v.size"
				]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"v.size*(0.8+0.9*math.abs(math.sin(math.floor(v.particle_age*16)*78.233+(v.particle_random_2*11.3+v.particle_random_4*5.9)*437.1)))",
					"0.04+math.mod(v.particle_random_4*5.1,1)*0.16"
				],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 32,
					"texture_height": 64,
					"flipbook": {
						"base_UV": [
							0,
							0
						],
						"size_UV": [
							32,
							16
						],
						"step_UV": [
							0,
							16
						],
						"frames_per_second": 18,
						"max_frame": 4,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"v.particle_random_4 < 0.33 ? 1.0 : (v.particle_random_4 < 0.66 ? 0.31 : (v.particle_random_4 < 0.85 ? 0.59 : 0.95))",
					"v.particle_random_4 < 0.33 ? 0.31 : (v.particle_random_4 < 0.66 ? 0.91 : (v.particle_random_4 < 0.85 ? 0.3 : 0.9))",
					"v.particle_random_4 < 0.33 ? 0.85 : (v.particle_random_4 < 0.66 ? 1.0 : (v.particle_random_4 < 0.85 ? 0.93 : 1.0))",
					"math.abs(math.sin(math.floor(v.particle_age*30)*78.233+(v.particle_random_3*9.7+v.particle_random_4*3.1)*437.1)) > 0.28 ? 1 : 0"
				]
			}
		}
	}
}
