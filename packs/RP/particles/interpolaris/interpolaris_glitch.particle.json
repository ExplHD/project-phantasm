{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:interpolaris_glitch",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/interpolaris/glitch"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.size = v.size ?? 0.5;v.height = v.height ?? 1.8;v.life = v.life ?? 0.25;"
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 48,
				"max_particles": 24
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": "v.life"
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.1,0.22)"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [
					"(v.particle_random_1-0.5)*2.4*v.size + (math.abs(math.sin(math.floor(v.particle_age*22)*78.233+(v.particle_random_1*13.1+v.particle_random_3*7.7)*437.1))-0.5)*0.7",
					"v.particle_random_2*v.height + (math.abs(math.sin(math.floor(v.particle_age*22)*78.233+(v.particle_random_2*11.3+v.particle_random_4*5.9)*437.1))-0.5)*0.18",
					"(v.particle_random_3-0.5)*2.4*v.size"
				]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"(0.18+math.abs(math.sin((v.particle_random_2*11.3+v.particle_random_4*5.9)*91.3))*0.55)*(0.6+0.8*math.abs(math.sin(math.floor(v.particle_age*22)*78.233+(v.particle_random_1*13.1+v.particle_random_3*7.7)*437.1)))",
					"0.05+math.mod(v.particle_random_4*7.3,1)*0.12"
				],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 32,
					"texture_height": 64,
					"flipbook": {
						"base_UV": [
							0,
							0
						],
						"size_UV": [
							32,
							16
						],
						"step_UV": [
							0,
							16
						],
						"frames_per_second": 18,
						"max_frame": 4,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"v.particle_random_4 < 0.33 ? 1.0 : (v.particle_random_4 < 0.66 ? 0.31 : (v.particle_random_4 < 0.85 ? 0.59 : 0.95))",
					"v.particle_random_4 < 0.33 ? 0.31 : (v.particle_random_4 < 0.66 ? 0.91 : (v.particle_random_4 < 0.85 ? 0.3 : 0.9))",
					"v.particle_random_4 < 0.33 ? 0.85 : (v.particle_random_4 < 0.66 ? 1.0 : (v.particle_random_4 < 0.85 ? 0.93 : 1.0))",
					"math.abs(math.sin(math.floor(v.particle_age*30)*78.233+(v.particle_random_3*9.7+v.particle_random_4*3.1)*437.1)) > 0.28 ? 1 : 0"
				]
			}
		}
	}
}
