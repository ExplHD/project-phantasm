{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:forge_trooper_thruster",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 3
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1.1
			},
			"minecraft:emitter_shape_point": {
				"direction": ["math.random(-0.3,0.3)", -1, "math.random(-0.3,0.3)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.5
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0,180)",
				"rotation_rate": "math.random(-90,90)"
			},
			"minecraft:particle_initial_speed": "math.random(0.8,1.4)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 2
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.35-v.particle_age*0.2", "0.35-v.particle_age*0.2"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"flipbook": {
						"base_UV": [0, 10],
						"size_UV": [1, 1],
						"step_UV": [1, 0],
						"frames_per_second": 8,
						"max_frame": 6,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFB040",
						"1.0": "#FF401000"
					}
				}
			}
		}
	}
}
