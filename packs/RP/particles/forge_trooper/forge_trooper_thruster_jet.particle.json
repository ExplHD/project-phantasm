{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:forge_trooper_thruster_jet",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 40,
				"max_particles": 30
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"direction": ["math.random(-0.15, 0.15)", -1, "math.random(-0.15, 0.15)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.2, 0.3)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0, 180)",
				"rotation_rate": "math.random(-120, 120)"
			},
			"minecraft:particle_initial_speed": "math.random(2.5, 4)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 4
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.22 - v.particle_age * 0.5", "0.22 - v.particle_age * 0.5"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"flipbook": {
						"base_UV": [0, 10],
						"size_UV": [1, 1],
						"step_UV": [1, 0],
						"frames_per_second": 8,
						"max_frame": 6,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFF4C0",
						"0.35": "#FFFFA030",
						"1.0": "#00FF3A08"
					}
				}
			}
		}
	}
}
