{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:sky_gateway_beam_sparkle",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/sparkle"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 128
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_shape_point": {
				"offset": ["math.random(-0.15, 0.15)", 0, "math.random(-0.15, 0.15)"],
				"direction": [0, "math.random_integer(0, 1) * 2 - 1", 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(5.5, 7.5)"
			},
			"minecraft:particle_initial_speed": "math.random(4, 9)",
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.08 * (1 - v.particle_age / v.particle_lifetime * 0.5)", "0.08 * (1 - v.particle_age / v.particle_lifetime * 0.5)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 64,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"frames_per_second": 8,
						"max_frame": 4,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFF4C0",
						"0.4": "#FFF4D306",
						"1.0": "#00E7B003"
					}
				}
			}
		}
	}
}
