{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:plunge_shockwave",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 120
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 0.15, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.4, 0.5)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0, 360)"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [
					"t.p = v.particle_age / v.particle_lifetime; t.r = 6 * (1 - math.pow(1 - t.p, 3)); return math.cos(v.particle_random_1 * 360) * t.r;",
					"return v.particle_random_2 * 0.4 * math.sin(180 * v.particle_age / v.particle_lifetime);",
					"t.p = v.particle_age / v.particle_lifetime; t.r = 6 * (1 - math.pow(1 - t.p, 3)); return math.sin(v.particle_random_1 * 360) * t.r;"
				]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.3 + v.particle_age * 0.6", "0.3 + v.particle_age * 0.6"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [56, 0],
						"size_UV": [8, 8],
						"step_UV": [-8, 0],
						"frames_per_second": 16,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": [0.85, 0.95, 1, 0.95],
						"0.6": [0.6, 0.85, 1, 0.7],
						"1.0": [0.5, 0.75, 1, 0]
					}
				}
			}
		}
	}
}
