{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:polaris_sparks",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/polaris/spark"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 14
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.3,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.35, 0.8)"
			},
			"minecraft:particle_initial_speed": "math.random(3, 8) * v.size",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 3.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.16 * (1 - v.particle_age / v.particle_lifetime)", "0.16 * (1 - v.particle_age / v.particle_lifetime)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 8,
					"texture_height": 8,
					"uv": [0, 0],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["v.color.r", "v.color.g", "v.color.b", "v.color.a"]
			}
		}
	}
}
