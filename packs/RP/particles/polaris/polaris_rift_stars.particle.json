					"uv_size": [256, "256 * (v.mode == 1 ? math.clamp(v.particle_age / 0.6, 0.02, 1) : (v.mode == 2 ? math.clamp((v.particle_lifetime - v.particle_age) / 0.6, 0, 1) : 1))"]
