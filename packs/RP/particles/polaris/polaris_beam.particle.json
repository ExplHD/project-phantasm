{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:polaris_beam",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/polaris/glow"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "v.count"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_box": {
				"half_dimensions": ["v.half_x", "v.half_y", "v.half_z"],
				"direction": [0, 1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "v.life"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.size * (0.9 + 0.1 * math.sin(v.particle_age * 1440 + v.particle_random_1 * 360))", "v.size * (0.9 + 0.1 * math.sin(v.particle_age * 1440 + v.particle_random_1 * 360))"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 32,
					"texture_height": 32,
					"uv": [0, 0],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["v.color.r", "v.color.g", "v.color.b", "v.color.a * math.clamp(v.particle_age / 0.05, 0, 1) * math.clamp((v.particle_lifetime - v.particle_age) / 0.15, 0, 1)"]
			}
		}
	}
}
