{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:polaris_portal",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/polaris/ring"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 8,
				"max_particles": 12
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": "math.max(0.1, v.life - 0.6)"
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.6
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"v.size * math.clamp(v.emitter_age / 0.25, 0.05, 1) * (1 - 0.85 * v.particle_age / v.particle_lifetime)",
					"v.size * math.clamp(v.emitter_age / 0.25, 0.05, 1) * (1 - 0.85 * v.particle_age / v.particle_lifetime)"
				],
				"facing_camera_mode": "direction_z",
				"direction": {
					"mode": "custom",
					"custom_direction": ["v.dir.x", "v.dir.y", "v.dir.z"]
				},
				"uv": {
					"texture_width": 64,
					"texture_height": 64,
					"uv": [0, 0],
					"uv_size": [64, 64]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["v.color.r", "v.color.g", "v.color.b", "v.color.a * math.clamp(v.particle_age / 0.06, 0, 1) * (1 - v.particle_age / v.particle_lifetime)"]
			}
		}
	}
}
