{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ph:parry_flash",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/circle_fade"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 20,
