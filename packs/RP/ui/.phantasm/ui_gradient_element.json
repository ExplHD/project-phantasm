{
    "namespace": "ui_gradient",
    // PARRY SUCCESS
    "parry_success_screen": {
        "$update_string": "parry_success:",
        "type": "panel",
        "size": [
            "100%",
            "100%"
        ],
        "factory": {
            "name": "parry_success_factory",
            "control_name": "ui_gradient.gradient_parry_success"
        },
        "bindings": [
            {
                "binding_type": "view",
                "source_control_name": "data_control_parry_success",
                "source_property_name": "(not ((#preserved_text - $update_string) = #preserved_text))",
                "target_property_name": "#visible"
            }
        ]
    },
    "gradient_parry_success": {
        "size": [
            "100%",
            "100%"
        ],
        "anchor_from": "center",
        "anchor_to": "center",
        "type": "image",
        "anims": [
            "@ui_gradient.parry_success_anim_alpha"
        ],
        "texture": "textures/ui/gradient/blue_gradient",
        "fill": true
    },
    "parry_success_anim_alpha": {
        "anim_type": "alpha",
        "easing": "out_expo",
        "duration": 1,
        "from": 1,
        "to": 0,
        "destroy_at_end": "parry_success_screen",
        "end_event": "parry_success_complete"
    }
}