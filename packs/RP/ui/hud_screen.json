{
    "namespace": "hud",
    "item_name_text_root/item_text_aligner/item_text_control": {
        "controls": [
            {
                "item_text_label2": {
                    "type": "panel",
                    "size": [
                        200,
                        10
                    ],
                    "clips_children": true,
                    "controls": [
                        {
                            "black_background": {
                                "type": "image",
                                "layer": 0,
                                "size": [
                                    200,
                                    20
                                ],
                                "anchor_from": "top_middle",
                                "anchor_to": "top_middle",
                                "texture": "textures/none",
                                "alpha": 0
                            }
                        },
                        {
                            "item_name_text": {
                                "type": "label",
                                "max_size": [
                                    200,
                                    "default"
                                ],
                                "text_alignment": "center",
                                "layer": 31,
                                "anchor_from": "top_middle",
                                "anchor_to": "top_middle",
                                "text": "#text",
                                "alpha": "@hud.anim_item_name_text_alpha_in",
                                "enable_profanity_filter": false,
                                "bindings": [
                                    {
                                        "binding_name": "$text_binding",
                                        "binding_name_override": "#text"
                                    }
                                ],
                                "color": "$text_color"
                            }
                        }
                    ],
                    "bindings": [
                        {
                            "binding_type": "view",
                            "source_control_name": "hide_item_enchant",
                            "source_property_name": "#toggle_state",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            }
        ]
    },
    "hud_title_text/title_frame/title_background": {
        "alpha": 0
    },
    "hud_title_text/title_frame/title": {
        "modifications": [
            {
                "array_name": "bindings",
                "operation": "insert_back",
                "value": [
                    {
                        "binding_type": "view",
                        "source_property_name": "(((#text - 'parry_success') = #text) and ((#text - 'bar0:') = #text))",
                        "target_property_name": "#visible"
                    }
                ]
            }
        ]
    },
    "centered_gui_elements_at_bottom_middle": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "replace",
                "control_name": "heart_rend",
                "value": [
                    {
                        "custom_health_bar@player_health.custom_health_bar": {
                            "offset": [
                                -1,
                                -32
                            ],
                            "anchor_from": "bottom_left",
                            "anchor_to": "bottom_left"
                        }
                    }
                ]
            },
            {
                "array_name": "controls",
                "operation": "remove",
                "control_name": "armor_rend"
            }
        ]
    },
    "centered_gui_elements_at_bottom_middle_touch": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "replace",
                "control_name": "heart_rend",
                "value": [
                    {
                        "custom_health_bar@player_health.custom_health_bar": {
                            "offset": [
                                -1,
                                -32
                            ],
                            "anchor_from": "bottom_left",
                            "anchor_to": "bottom_left"
                        }
                    }
                ]
            },
            {
                "array_name": "controls",
                "operation": "remove",
                "control_name": "armor_rend"
            }
        ]
    },
    "not_centered_gui_elements": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "replace",
                "control_name": "heart_rend",
                "value": [
                    {
                        "custom_health_bar@player_health.custom_health_bar": {
                            "offset": [
                                19,
                                14
                            ],
                            "anchor_from": "top_left",
                            "anchor_to": "top_left"
                        }
                    }
                ]
            },
            {
                "array_name": "controls",
                "operation": "remove",
                "control_name": "armor_rend"
            }
        ]
    },
    "root_panel": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "health_data_control": {
                            "type": "panel",
                            "size": [
                                0,
                                0
                            ],
                            "$update_string": "bar0:",
                            "property_bag": {
                                "#preserved_text": ""
                            },
                            "bindings": [
                                {
                                    "binding_name": "#hud_title_text_string"
                                },
                                {
                                    "binding_name": "#hud_title_text_string",
                                    "binding_name_override": "#preserved_text",
                                    "binding_condition": "visibility_changed"
                                },
                                {
                                    "binding_type": "view",
                                    "source_property_name": "(not (#hud_title_text_string = #preserved_text) and not ((#hud_title_text_string - $update_string) = #hud_title_text_string))",
                                    "target_property_name": "#visible"
                                }
                            ]
                        }
                    } /*,
                    {
                        "parry_success_screen@ui_gradient.parry_success_screen": {}
                    },
                    { // For namespace "ui_gradient"
                        "data_control_parry_success": {
                            "type": "panel",
                            "size": [
                                0,
                                0
                            ],
                            "$update_string": "parry_success:",
                            "property_bag": {
                                "#preserved_text": ""
                            },
                            "bindings": [
                                {
                                    "binding_name": "#hud_title_text_string"
                                },
                                {
                                    "binding_name": "#hud_title_text_string",
                                    "binding_name_override": "#preserved_text",
                                    "binding_condition": "visibility_changed"
                                },
                                {
                                    "binding_type": "view",
                                    "source_property_name": "(not (#hud_title_text_string = #preserved_text) and not ((#hud_title_text_string - $update_string) = #hud_title_text_string))",
                                    "target_property_name": "#visible"
                                }
                            ]
                        }
                    }*/
                ]
            }
        ]
    }
}