{
	// Guidebook router: renders guide forms inside a book shell.
	// Guide screens opt in by suffixing their ActionForm title with the
	// invisible marker defined in data/scripts/guidescreen/guidebook_title.ts
	// (currently "§r§0§7" — reset + two color codes, renders as nothing).
	// Every other server form keeps the vanilla long_form below (fallback).
	"namespace": "server_form",

	// Hide the vanilla dialog only when the guidebook marker is present.
	"long_form": {
		"modifications": [
			{
				"array_name": "bindings",
				"operation": "insert_back",
				"value": [
					{
						"binding_name": "#title_text"
					},
					{
						"binding_type": "view",
						"source_property_name": "((#title_text - '§r§0§7') = #title_text)",
						"target_property_name": "#visible"
					}
				]
			}
		]
	},

	// Custom factory product for action forms. Holds #title_text so the
	// gated book below can test the marker (bedrock.wiki server-form recipe).
	"ph_book_long_form_panel": {
		"type": "panel",
		"bindings": [
			{
				"binding_name": "#title_text"
			}
		],
		"controls": [
			{
				"ph_book@ph_guidebook.book": {
					"bindings": [
						{
							"binding_type": "view",
							"source_control_name": "ph_book_long_form_panel",
							"source_property_name": "(not ((#title_text - '§r§0§7') = #title_text))",
							"target_property_name": "#visible"
						}
					]
				}
			}
		]
	},

	"main_screen_content": {
		"modifications": [
			{
				"array_name": "controls",
				"operation": "insert_back",
				"value": [
					{
						"ph_book_factory": {
							"type": "panel",
							"factory": {
								"name": "server_form_factory",
								"control_ids": {
									"long_form": "@server_form.ph_book_long_form_panel"
								}
							}
						}
					}
				]
			}
		]
	}
}
