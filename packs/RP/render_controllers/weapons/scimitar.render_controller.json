{
	"format_version": "1.10.0",
	"render_controllers": {
		"controller.render.ph.scimitar": {
			"geometry": "Geometry.default",
			"materials": [
				{
					"*": "variable.is_enchanted ? Material.enchanted : Material.default"
				}
			],
			"textures": [
				"Texture.default",
				"Texture.enchanted"
			],
			"part_visibility": [
				{
					"*": true
				},
				{
					"weapon_root": "!variable.is_off_hand"
				},
				{
					"blade*": "!variable.is_off_hand"
				},
				{
					"bone*": "!variable.is_off_hand"
				},
				{
					"left_*": "variable.is_off_hand"
				}
			]
		}
	}
}
