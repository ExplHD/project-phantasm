{
	"format_version": "1.10.0",
	"render_controllers": {
		"controller.render.ph.interpolaris": {
			"geometry": "Geometry.default",
			"materials": [
				{
					"*": "variable.is_enchanted ? Material.enchanted : Material.default"
				}
			],
			"textures": [
				"Texture.default",
				"Texture.enchanted"
			],
			"part_visibility": [
				{
					"*": true
				},
				{
					"fp_*": "(v.interp_first_person ?? 0)"
				},
				{
					"tp_*": "!(v.interp_first_person ?? 0)"
				}
			]
		},
		"controller.render.ph.interpolaris_sword": {
			"geometry": "Geometry.default",
			"materials": [
				{
					"*": "Material.default"
				}
			],
			"textures": [
				"Texture.default"
			]
		}
	}
}
