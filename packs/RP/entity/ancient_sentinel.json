{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "ph:ancient_sentinel",
            "materials": {
                "default": "entity_alphatest"
            },
            "geometry": {
                "default": "geometry.ph.ancient_sentinel"
            },
            "textures": {
                "default": "textures/entity/ancient_sentinel"
            },
            "render_controllers": [
                "controller.render.ph.ancient_sentinel"
            ],
            "scripts": {
                "pre_animation": [
                    "variable.state = query.property('ph:sentinel_state');",
                    "variable.is_dormant = variable.state == 'dormant';",
                    "variable.is_awakening = variable.state == 'awakening';",
                    "variable.is_ball = variable.state == 'ball';",
                    "variable.is_roll = variable.state == 'roll';",
                    "variable.is_unrolling = variable.state == 'unrolling';",
                    "variable.is_rolled_up = variable.is_dormant || variable.is_awakening || variable.is_ball || variable.is_roll;",
                    "variable.use_rolled_up_model = variable.is_rolled_up;",
                    "variable.rolled_up_time = variable.is_rolled_up ? ((variable.rolled_up_time ?? 0.0) + query.delta_time) : 0.0;",
                    "variable.hide_head = variable.is_dormant || variable.rolled_up_time >= 0.2083;",
                    "variable.x_head_rotation = math.clamp(query.target_x_rotation, -32.5, 32.5);",
                    "variable.y_head_rotation = math.clamp(query.target_y_rotation, -22.5, 25);",
                    "variable.walking = !variable.is_rolled_up && query.modified_move_speed > 0.01;",
                    "variable.roll_yaw_target = query.property('ph:roll_yaw');",
                    "variable.roll_flip = variable.is_roll && math.cos(variable.roll_yaw_target - (variable.roll_yaw ?? variable.roll_yaw_target)) < 0;",
                    "variable.roll_yaw = variable.roll_yaw_target;",
                    "variable.roll_local_yaw = variable.roll_yaw - query.body_y_rotation;",
                    "variable.roll_angle = variable.is_roll ? (variable.roll_flip ? -1 : 1) * (variable.roll_angle ?? 0) + query.ground_speed * 83 * query.delta_time : 0;",
                    "variable.walk_anim_time_update = query.anim_time + math.min(3.0, math.lerp(2.0, 5.0, query.modified_move_speed)) * query.delta_time;"
                ],
                "animate": [
                    "state_controller",
                    "look_at_target_controller",
                    "walk_controller"
                ],
                "should_update_effects_offscreen": "1.0"
            },
            "animations": {
                "look_at_target": "animation.armadillo.look_at_target",
                "look_at_target_controller": "controller.animation.armadillo.look_at_target",
                "walk": "animation.armadillo.walk",
                "walk_controller": "controller.animation.armadillo.walk",
                "baby_walk": "animation.armadillo.baby_walk",
                "roll_up": "animation.armadillo.roll_up",
                "rolled_up": "animation.armadillo.rolled_up",
                "unroll_fast": "animation.armadillo.unroll_fast",
                "state_controller": "controller.animation.ph.sentinel.state",
                "struggle": "animation.ph.sentinel.struggle",
                "roll_spin": "animation.ph.sentinel.roll_spin",
                "slam": "animation.ph.sentinel.slam",
                "launch": "animation.ph.sentinel.launch",
                "roar": "animation.ph.sentinel.roar"
            },
            "sound_effects": {
                "roll": "mob.armadillo.roll",
                "land": "mob.armadillo.land",
                "peek": "mob.armadillo.peek",
                "unroll_start": "mob.armadillo.unroll_start",
                "unroll_finish": "mob.armadillo.unroll_finish"
            },
            "spawn_egg": {
                "base_color": "#8A6D4B",
                "overlay_color": "#4E3B26"
            }
        }
    }
}
