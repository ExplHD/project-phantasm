{
	"format_version": "1.8.0",
	"animations": {
		"animation.plasmoid_drone.idle": {
			"loop": true,
			"animation_length": 0.25,
			"bones": {
				"motor1": {
					"rotation": {
						"0.0": [0, 0, 0],
						"0.25": [0, 360, 0]
					}
				},
				"motor2": {
					"rotation": {
						"0.0": [0, 0, 0],
						"0.25": [0, 360, 0]
					}
				}
			}
		},
		"animation.plasmoid_drone.move": {
			"loop": true,
			"animation_length": 0.0417,
			"bones": {
				"bone": {
					"rotation": [
						"(query.has_target ? 0 : ((query.modified_move_speed < 0.45 ? 0 : math.clamp((query.modified_move_speed - 0.45) * 30, 0, 14)) + (math.abs(query.vertical_speed) < 0.35 ? 0 : (query.vertical_speed < 0 ? math.clamp(-query.vertical_speed * 20, 0, 12) : math.clamp(-query.vertical_speed * 45, -30, 0)))))",
						0,
						"math.clamp(query.yaw_speed * 0.02, -20, 20)"
					]
				}
			},
			"particle_effects": {
				"0.0": {
					"effect": "plasmoid_drone_trail",
					"locator": "locator2"
				}
			}
		},
		"animation.plasmoid_drone.look_at_target": {
			"loop": true,
			"bones": {
				"bone": {
					"relative_to": {
						"rotation": "entity"
					},
					"rotation": ["math.clamp(query.target_x_rotation, -45, 45)", "query.target_y_rotation", 0]
				}
			}
		},
		"animation.plasmoid_drone.shoot": {
			"loop": true,
			"animation_length": 0.9583,
			"particle_effects": {
				"0.0": {
					"effect": "plasmoid_drone_charge",
					"locator": "locator"
				}
			}
		}
	}
}