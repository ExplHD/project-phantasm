{
	"$schema": "https://raw.githubusercontent.com/Bedrock-OSS/regolith-schemas/main/config/unified.json",
	"author": "ExplerHD",
	"name": "Phantasm",
	"packs": {
		"behaviorPack": "./BP",
		"resourcePack": "./RP"
	},
	"regolith": {
		"dataPath": "./data",
		"filterDefinitions": {
			"mcaddon": {
				"url": "github.com/lightyisreal/regolith-filters",
				"version": "a41eb063951b2b6ca31c45504d6bd1bfaff968f4"
			},
			"texture_list": {
				"url": "github.com/Bedrock-OSS/regolith-filters",
				"version": "1.1.3"
			}
		},
		"formatVersion": "1.8.0",
		"profiles": {
			"default": {
				"export": {
					"bpPath": "${BEHAVIOR_PACK_PATH}",
					"rpPath": "${RESOURCE_PACK_PATH}",
					"target": "exact"
				},
				"filters": [
					{
						"filter": "texture_list"
					}
				]
			},
			"build": {
				"export": {
					"target": "none"
				},
				"filters": [
					{
						"filter": "texture_list"
					},
					{
						"filter": "mcaddon"
					}
				]
			}
		},
		"watchPaths": [
			"./BP",
			"./RP"
		]
	}
}