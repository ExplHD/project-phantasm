{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.peacemaker_oath": {
            "initial_state": "default",
            "states": {
                "default": {
                    "animations": [
                        {
                            "peacemaker_oath_fpp": "v.is_first_person"
                        },
                        {
                            "peacemaker_oath_default": "!v.is_first_person"
                        }
                    ],
                    "blend_transition": 0.1,
                    "transitions": [
                        {
                            "fire": "query.get_equipped_item_name=='peacemaker_oath'&&query.is_using_item"
                        }
                    ]
                },
                "fire": {
                    "animations": [
                        "peacemaker_oath_fire"
                    ],
                    "transitions": [
                        {
                            "default": "query.any_animation_finished('peacemaker_oath_fire')"
                        }
                    ]
                }
            }
        }
    }
}